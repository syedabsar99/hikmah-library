rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if authenticated user has Admin custom claim or role
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'hikmahlibrary6@gmail.com' ||
        request.auth.token.email == 'admin@hikmahlibrary.com' ||
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid))
      );
    }
    
    // Helper function to check if the user is the owner of the record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Admin Roles collection: strictly managed by primary administrator
    match /admin_roles/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Member Profiles collection (FULL PRIVATE PROFILES)
    // Members can ONLY read their own profile; Admin can read and write all member profiles
    // Prevents self-promotion or tampering with membership status / warning count / fee records
    match /member_profiles/{memberDocId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.uid == request.auth.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.membershipStatus == resource.data.membershipStatus &&
        request.resource.data.warningCount == resource.data.warningCount
      );
    }

    // Member Directory collection (SEPARATE PUBLIC/STUDENT DIRECTORY)
    // Exposes ONLY non-sensitive fields needed for peer identification & lounge chat:
    // (id, uid, fullName, seatNumber, batch, studyTarget, membershipStatus, avatarUrl)
    // Strictly NO passcodes, NO emails, NO phone numbers, NO fee records!
    match /member_directory/{memberDocId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl', 'uid'])
      );
    }
    
    // Attendance Records collection
    // Members can ONLY read their own attendance records; Admin can create and update
    match /attendance_records/{attendanceId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    
    // Warning Records collection
    // Members can ONLY read their own warning records; Admin issues and audits warnings
    match /warning_records/{warningId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    
    // Announcements and Fee Notices
    // Read: All authenticated members & public library visitors
    // Write: Strictly Admin only
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Dynamic Basic Facilities & Infrastructure
    // Read: Public visitors & members
    // Write: Strictly Admin only
    match /facilities/{facilityId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Dynamic Library Rules & Code of Conduct
    // Read: Public visitors & members
    // Write: Strictly Admin only
    match /rules/{ruleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Administrative Audit Logs
    // Strictly Admin access only; ordinary members have zero access
    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // Immutable audit logs
    }
    
    // PRIVATE MEMBER-TO-MEMBER & ADMIN CHAT (STRICT PRIVACY ENFORCEMENT)
    // Authorizes only the verified participants using Firebase Auth UIDs
    match /chat_messages/{messageId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participantUids ||
        request.auth.uid == resource.data.senderUid ||
        request.auth.uid == resource.data.recipientUid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        (request.auth.uid == request.resource.data.senderUid || isAdmin()) &&
        (request.auth.uid in request.resource.data.participantUids || isAdmin())
      );
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.recipientUid || isAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.senderUid ||
        request.auth.uid == resource.data.recipientUid ||
        isAdmin()
      );
    }
    
    match /chat_sessions/{sessionId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid in resource.data.participantUids ||
        request.auth.uid in request.resource.data.participantUids ||
        isAdmin()
      );
    }
    
    match /temporary_chat_messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.senderUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if false; // Messages cannot be altered
    }

    // Default catch-all rule: Deny all unmatched collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
