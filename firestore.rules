rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if authenticated user has Admin custom claim or role
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid))
      );
    }
    
    // Helper function to check if the user is the owner of the record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Admin Roles collection: strictly managed by primary administrator
    match /admin_roles/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Member Profiles collection
    // Members can ONLY read their own profile; Admin can read and write all member profiles
    match /member_profiles/{memberDocId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    
    // Attendance Records collection
    // Members can ONLY read their own attendance records; Admin can create and update
    match /attendance_records/{attendanceId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    
    // Warning Records collection
    // Members can ONLY read their own warning records; Admin issues and audits warnings
    match /warning_records/{warningId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    
    // Announcements and Fee Notices
    // Read: All authenticated members & public library visitors
    // Write: Strictly Admin only
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Administrative Audit Logs
    // Strictly Admin access only; ordinary members have zero access
    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // Immutable audit logs
    }
    
    // PRIVATE MEMBER-TO-MEMBER CHAT (STRICT PRIVACY ENFORCEMENT)
    // The Admin role is STRICTLY DENIED access to chat sessions and ciphertext!
    // Only the two specific participants can access their encrypted messages.
    match /chat_sessions/{sessionId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid in resource.data.participantUids ||
        request.auth.uid in request.resource.data.participantUids
      );
    }
    
    match /temporary_chat_messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.senderUid == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid
      );
      allow update: if false; // Messages cannot be altered
    }
  }
}
